# Server configuration. DATABASE_URL is the only required variable.
#
# DATABASE_URL — any PostgreSQL connection string. The app reads it from the
# environment only (Prisma `env("DATABASE_URL")`); there is no hardcoded
# fallback. In production point it at your managed Postgres (Neon, RDS,
# Supabase, …) — no code changes needed.
#
# For local dev, `npm run db` starts an embedded Postgres (dev-only; it refuses
# to run with NODE_ENV=production) matching the connection string below.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/siddhatva?schema=public"

# Set to "production" when deployed. The platform (Railway/Render/Fly) usually
# sets this for you; it gates the embedded dev Postgres off and hardens cookies.
# NODE_ENV=production

# HTTP port the API listens on (default 4000). Most hosts inject their own PORT.
PORT=4000

# Allowed browser origins for CORS, comma-separated. In production list the
# real frontend origin(s); keep localhost:3000 if you also want local dev
# against this API. (Legacy single CORS_ORIGIN still works as a fallback.)
# e.g. CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Set to true/1 when deployed behind a trusted proxy/CDN (Vercel, Railway) so the
# real client IP is read from X-Forwarded-For (rate limits become per-user, not
# per-proxy). Leave unset in local dev — the header would otherwise be spoofable.
# TRUST_PROXY=true

# Auth. Set a strong secret in production; dev uses an obvious fallback.
JWT_ACCESS_SECRET=change-me-in-production
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7

# Image store. When all three CLOUDINARY_* are set, images upload to Cloudinary
# (signed direct-from-browser, optimized f_auto/q_auto delivery, delete by
# public_id). When unset, a local dev image store is used instead (files served
# from /uploads) — activating Cloudinary later is credentials-only, no code change.
# The API secret is used server-side only and never sent to the client.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Public origin of this API (used to build local dev image URLs). Defaults to
# http://localhost:PORT.
# PUBLIC_URL=http://localhost:4000

# Razorpay (test mode). When key id + secret are set, payments use the real
# gateway; otherwise they run in mock mode (see PAYMENTS.md). The secret and
# webhook secret are server-side only — only the key id reaches the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public origin of the storefront (frontend), used to build links in emails
# (e.g. "View your order"). Defaults to the first CORS_ORIGINS entry.
# APP_URL=http://localhost:3000

# Resend (transactional email). When RESEND_API_KEY is set, order lifecycle
# emails send via Resend; otherwise they render to the console and to server/.mail/
# (dev fallback — no account needed). Activating real email is credentials-only.
# The API key is server-side only. See RESEND.md.
#
# EMAIL_FROM must be an address on a domain you've verified in Resend (SPF/DKIM),
# except Resend's shared onboarding@resend.dev sender used for first tests.
RESEND_API_KEY=
# EMAIL_FROM="Siddhatva <orders@yourdomain.com>"

# Shiprocket (logistics). When email + password are set, shipments use the real
# Shiprocket API; otherwise they run in mock mode (see SHIPROCKET.md) — the full
# two-way flow (create shipment + inbound tracking webhook) works with no account.
# Credentials + webhook token are server-side only. Real API access needs a paid
# Shiprocket tier at go-live (build/test is free in mock mode).
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Optional: the sales channel id + pickup location configured in Shiprocket.
# SHIPROCKET_CHANNEL_ID=
# SHIPROCKET_PICKUP_LOCATION=Primary
# Token you set on the Shiprocket tracking webhook; verified via its x-api-key
# header. In mock mode a fixed dev token is used instead.
SHIPROCKET_WEBHOOK_TOKEN=
