# Server configuration. DATABASE_URL is the only required variable.
#
# DATABASE_URL — any PostgreSQL connection string. The app reads it from the
# environment only (Prisma `env("DATABASE_URL")`); there is no hardcoded
# fallback. In production point it at your managed Postgres (Neon, RDS,
# Supabase, …) — no code changes needed.
#
# For local dev, `npm run db` starts an embedded Postgres (dev-only; it refuses
# to run with NODE_ENV=production) matching the connection string below.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/siddhatva?schema=public"

# HTTP port the API listens on (default 4000).
PORT=4000

# Allowed browser origin for CORS (the frontend dev server).
CORS_ORIGIN=http://localhost:3000

# Auth. Set a strong secret in production; dev uses an obvious fallback.
JWT_ACCESS_SECRET=change-me-in-production
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7

# Image store. When all three CLOUDINARY_* are set, images upload to Cloudinary
# (signed direct-from-browser, optimized f_auto/q_auto delivery, delete by
# public_id). When unset, a local dev image store is used instead (files served
# from /uploads) — activating Cloudinary later is credentials-only, no code change.
# The API secret is used server-side only and never sent to the client.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Public origin of this API (used to build local dev image URLs). Defaults to
# http://localhost:PORT.
# PUBLIC_URL=http://localhost:4000
