# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
/test-results
/playwright-report
/blob-report
/.playwright
.last-run.json

# production
/build

# misc
.DS_Store

# Env: never commit real secrets — only .env.example is tracked. (VITE_* values
# are baked into the client bundle and are public, but keep the file untracked
# so per-environment values don't get committed.)
.env
.env.*
!.env.example

npm-debug.log*
yarn-debug.log*
yarn-error.log*
