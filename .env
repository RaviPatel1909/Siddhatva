# API base URL.
# Relative path (e.g. /api) → intercepted by the MSW mock worker (offline dev).
# Absolute URL → the real backend; MSW is auto-disabled.
# Phase 3 backend (server/) serves the contract routes here:
VITE_API_URL=http://localhost:4000/api

# Set VITE_USE_MSW=true to force the MSW mock even with a real VITE_API_URL.
