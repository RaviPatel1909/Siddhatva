# Frontend environment (Vite). Copy to .env and adjust.

# API base URL.
# Relative path (e.g. /api) → intercepted by the MSW mock worker (offline dev).
# Absolute URL → the real backend; MSW is auto-disabled.
VITE_API_URL=http://localhost:4000/api

# Set VITE_USE_MSW=true to force the MSW mock even with a real VITE_API_URL.
# VITE_USE_MSW=true

# GA4 measurement ID (e.g. G-XXXXXXXXXX). When set, the GA4 tag loads and the
# ecommerce funnel events (view_item, add_to_cart, begin_checkout, purchase) are
# sent. When UNSET, analytics is disabled entirely — no tag, no console noise.
# VITE_GA4_ID=G-XXXXXXXXXX
